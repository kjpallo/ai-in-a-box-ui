    "test:classroom-core": "npm test && npm run test:bank && npm run test:approved-knowledge-pack-loader && npm run test:standards-summary",
    "test:teacher-content": "npm run test:teacher-content-adapter && npm run test:teacher-content-routes && npm run test:teacher-content-ui && npm run test:upload-text-extraction && npm run test:generate-draft-pack",
    "test:all": "npm test && npm run test:bank",
    "test:auth": "node scripts/test-teacher-auth.js",
    "test:classroom-controls": "node scripts/test-classroom-controls.js",
    "test:live-activity-ui": "node scripts/test-live-activity-ui.js",
    "test:live-student-activity": "node scripts/test-live-student-activity.js",
    "reset:teacher-auth": "node scripts/reset-teacher-auth.js",
    "test:bank": "node scripts/test-router-bank.js",
    "test:charlemagne-output-regressions": "node scripts/test-charlemagne-output-regressions.js",
    "test:motion-force-student-regressions": "node scripts/test-motion-force-student-regressions.js",
    "test:motion-force-knowledge": "node scripts/test-motion-force-knowledge.js",
    "test:standards": "node scripts/test-standards-matcher.js",
    "test:standards-bank": "node scripts/test-standards-bank-validation.js && node scripts/validate-standards-bank.js && node scripts/test-missouri-standards-bank.js",
    "test:standards-profile": "node scripts/test-standards-profile-matcher.js",
    "test:standards-log": "node scripts/test-standards-log-shape.js",
    "test:standards-log-examples": "node scripts/test-standards-log-metadata-examples.js",
    "test:standards-summary": "node scripts/test-standards-summary-report.js",
    "test:questions-standards-export": "node scripts/test-questions-standards-export.js && node scripts/test-questions-standards-session-archive.js && node scripts/test-questions-standards-auto-archive.js && node scripts/test-questions-standards-archive-records.js && node scripts/test-questions-standards-ui.js",
    "test:student-session-archive": "node scripts/test-student-session-archive-route.js",
    "test:knowledge-pack": "node scripts/test-knowledge-pack-validation.js && node scripts/validate-knowledge-pack.js",
    "test:approved-packs": "node scripts/test-approved-knowledge-pack-loader.js",
    "test:approved-knowledge-pack-loader": "node scripts/test-approved-knowledge-pack-loader.js && node scripts/test-enabled-approved-knowledge-items.js",
    "test:knowledge-graph": "node scripts/test-knowledge-graph.js",
    "test:knowledge-graph-answers": "node scripts/test-knowledge-graph-answers.js",
    "test:knowledge-graph-routing-support": "node scripts/test-knowledge-graph-routing-support.js",
    "test:knowledge-graph-tutor-support": "node scripts/test-knowledge-graph-tutor-support.js",
    "test:unit9-balancing-workspace": "node scripts/test-unit9-balancing-workspace.js",
    "test:draft-packs": "node scripts/test-draft-knowledge-pack-workspace.js",
    "test:promote-draft-pack": "node scripts/test-promote-draft-knowledge-pack.js",
    "test:review-draft-pack": "node scripts/test-review-draft-knowledge-pack.js",
    "test:teacher-content-adapter": "node scripts/test-teacher-content-adapter.js",
    "test:teacher-content-routes": "node scripts/test-teacher-content-routes.js",
    "test:teacher-content-ui": "node scripts/test-teacher-content-ui.js",
    "test:import-pipeline-dry-run": "node scripts/test-import-pipeline-dry-run.js",
    "test:import-pipeline-report": "node scripts/test-import-pipeline-report.js",
    "test:upload-extraction": "node scripts/test-upload-text-extraction.js",
    "test:upload-text-extraction": "node scripts/test-upload-text-extraction.js",
    "test:generate-draft-pack": "node scripts/test-generate-draft-knowledge-pack.js",
    "test:voice-input": "node scripts/test-voice-input-organization.js",
    "extract:upload-text": "node scripts/extract-upload-text.js",
    "inspect:approved-packs": "node scripts/inspect-approved-knowledge-packs.js",
    "inspect:draft-packs": "node scripts/inspect-draft-knowledge-packs.js",
    "audit:motion-force-overlap": "node scripts/audit-motion-force-overlap.js",
    "audit:standards-metadata": "node scripts/audit-standards-metadata.js",
    "check:cleanup": "node scripts/test-voice-input-organization.js && node scripts/project-cleanup-check.js",
    "review:zip": "bash scripts/create-review-zip.sh"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.13",
    "csv-parse": "^6.2.1",
    "express": "^4.19.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "mathjs": "^15.2.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  }
}
